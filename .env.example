# Root convenience template. The backend reads backend/.env; the frontend reads
# frontend/.env.local. This file documents the values both sides share.
#
# Copy the specific file you need. Never commit a filled-in copy: .env,
# .env.local and *.db are git-ignored.

# --- Backend (see backend/.env.example for the full list) --------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DATABASE_URL=sqlite:///./rat_detection.db
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_API_KEYS=

# --- Frontend (see frontend/.env.example) ------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_PORT=5173

# --- Firmware (goes into firmware/robot/config.local.h, not here) -----------
# WIFI_SSID=
# WIFI_PASSWORD=
# BACKEND_HOST=192.168.1.10
# DEVICE_ID=ESP32-01
