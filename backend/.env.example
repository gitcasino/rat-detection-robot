# Backend configuration. Copy to .env and adjust. Never commit the real file.
# Values shown are the defaults used when the variable is absent.

# --- HTTP server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# --- Persistence -------------------------------------------------------------
# Relative SQLite paths resolve against the process working directory.
DATABASE_URL=sqlite:///./rat_detection.db

# --- Dashboard access --------------------------------------------------------
# Comma separated. Add the frontend origin when it is not on the default port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Device presence ---------------------------------------------------------
# A device with no telemetry for this long is reported OFFLINE.
DEVICE_OFFLINE_TIMEOUT_S=15
OFFLINE_SCAN_INTERVAL_S=2

# --- Ingest limits -----------------------------------------------------------
# Minimum gap between two persisted telemetry snapshots per device.
TELEMETRY_PERSIST_INTERVAL_S=5
MAX_PAYLOAD_BYTES=65536

# Device timestamps further from server time than this are replaced by the
# server clock and flagged with device_timestamp_rejected.
DEVICE_CLOCK_SKEW_TOLERANCE_S=900

# 0 disables retention entirely; nothing is ever deleted automatically otherwise.
EVENT_RETENTION_DAYS=0

# --- Access control (optional) ----------------------------------------------
# Comma separated device ids. Empty means any device id is accepted.
ALLOWED_DEVICE_IDS=

# Comma separated shared secrets accepted via the X-API-Key header.
# Empty means ingestion endpoints are open, which suits a trusted LAN demo.
API_KEYS=

# --- History queries ---------------------------------------------------------
HISTORY_DEFAULT_LIMIT=100
HISTORY_MAX_LIMIT=1000
